# Optional overrides. The launcher (scripts/run-control-panel.*) sets these
# for you. Copy to .env only if you run uvicorn manually.
# (config.py reads os.environ — nothing loads .env automatically unless you
# export vars yourself or use `uvicorn --env-file .env`.)

# Root of Talos's local state. Default if unset: ~/.talos
# TALOS_HOME=

# Talos monorepo root (contains pyproject.toml). Default: auto-detected.
# TALOS_ROOT=

# Python used for `python -m talos`. Default: <TALOS_ROOT>/.venv/...
# TALOS_PYTHON=

# Timeout in seconds for a single CLI invocation.
TALOS_CP_CLI_TIMEOUT=60

# Where this control panel's own API listens.
CP_HOST=127.0.0.1
CP_PORT=8420
